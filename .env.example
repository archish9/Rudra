# RudraAnvil Environment Configuration
# Copy this file to .env and fill in your values

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
# Dual-model: set these to use different models for planning vs coding
# Falls back to OLLAMA_MODEL if not set
OLLAMA_MODEL_PLANNER=qwen3:14b
OLLAMA_MODEL_CODER=qwen3-coder:30b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT=300
OLLAMA_NUM_PREDICT=2048

# Agent Configuration
# Set to false to silence detailed agent logs
VERBOSE=true


