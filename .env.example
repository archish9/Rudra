# RudraAnvil Environment Configuration
# Copy this file to .env and fill in your values

# Ollama Configuration
# Minimum supported local model size is 32B (TODO.md D6). Smaller models
# were the design center for the deleted qwen3:14b workarounds and are no
# longer supported.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:32b
# Dual-model: set these to use different models for planning vs coding
# Falls back to OLLAMA_MODEL if not set
OLLAMA_MODEL_PLANNER=qwen3:32b
OLLAMA_MODEL_CODER=qwen3-coder:32b
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT=300
OLLAMA_NUM_PREDICT=131072

# Agent Configuration
# Set to false to silence detailed agent logs
VERBOSE=true


